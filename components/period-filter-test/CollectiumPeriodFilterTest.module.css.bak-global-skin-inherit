.page {
  min-height: 100vh;
  padding: 10px;
  background: #f4f8fc;
  color: #07356e;
  font-family: var(--font-geist-sans, Arial, sans-serif);
}

.hero,
.filterColumn,
.timelineShell,
.dynamicArea {
  border: 1px solid #d5e5f7;
  border-radius: 16px;
  background: rgba(255,255,255,.95);
  box-shadow: 0 10px 30px rgba(7, 53, 110, .08);
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 16px;
  margin-bottom: 10px;
}

.hero h1 {
  margin: 0;
  font-size: clamp(30px, 4vw, 54px);
  line-height: .95;
  font-family: Georgia, serif;
  color: #0a4285;
}

.hero p {
  max-width: 1050px;
  margin: 8px 0 0;
  color: #466a97;
  font-size: 14px;
}

.eyebrow {
  margin: 0 0 5px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .08em;
  font-weight: 800;
  color: #56749a;
}

.statusBox {
  min-width: 170px;
  border: 1px solid #d9e8f9;
  border-radius: 14px;
  padding: 12px;
  background: #f9fbfe;
}

.statusBox strong {
  display: block;
  font-size: 18px;
  color: #0c4c91;
}

.statusBox span {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #56749a;
}

.errorBox {
  border: 1px solid #f0b4b4;
  background: #fff4f4;
  color: #9b1c1c;
  padding: 12px;
  border-radius: 12px;
  margin-bottom: 10px;
}

.layout {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.filterColumn {
  width: min(520px, 100%);
  align-self: flex-end;
  padding: 10px;
  position: static;
  border: 1px solid #d5e5f7;
  border-radius: 16px;
  background: rgba(255,255,255,.96);
  box-shadow: 0 10px 30px rgba(7, 53, 110, .08);
}

.filterColumnHeader h2,
.timelineHeader h2,
.dynamicArea h2 {
  margin: 0;
  font-family: Georgia, serif;
  color: #0b4387;
}

.selectBox {
  display: block;
  border: 1px solid #d8e6f6;
  border-radius: 10px;
  background: #f9fcff;
  padding: 7px 8px;
  margin-top: 6px;
}

.selectBox span {
  display: block;
  margin-bottom: 3px;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .08em;
  font-weight: 900;
  color: #56749a;
}

.selectBox select {
  width: 100%;
  border: 1px solid #cfe0f4;
  border-radius: 8px;
  padding: 8px 9px;
  background: #fff;
  color: #07356e;
  font-weight: 900;
  font-size: 13px;
}

.selectBox small {
  display: block;
  min-height: 18px;
  margin-top: 4px;
  color: #5a7493;
  font-size: 10px;
  font-style: italic;
  line-height: 1.25;
}

.filterDivider {
  margin: 13px 0 4px;
  border-top: 1px solid #d8e6f6;
  padding-top: 10px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .08em;
  font-weight: 900;
  color: #0b4387;
}

.selectedStack {
  margin-top: 12px;
  border: 1px solid #d8e6f6;
  border-radius: 12px;
  padding: 10px;
  background: #fff;
}

.selectedStack strong,
.selectedStack span {
  display: block;
}

.selectedStack strong {
  margin-bottom: 6px;
  color: #0b4387;
}

.selectedStack span {
  border-top: 1px solid #edf3fa;
  padding: 5px 0;
  font-size: 12px;
  font-weight: 800;
}

.mainColumn {
  width: 100%;
  min-width: 0;
}

.timelineShell {
  padding: 12px;
  margin-bottom: 10px;
}

.timelineHeader {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-bottom: 10px;
}

.timelineTools {
  display: flex;
  gap: 8px;
}

.timelineTools button,
.segment.segmentTabs button {
  border: 1px solid #cadcf2;
  border-radius: 12px;
  background: #fff;
  color: #07356e;
  cursor: pointer;
  font-weight: 900;
  padding: 10px 14px;
}

.timelineTools button[data-active="true"],
.segmentTabs button[data-active="true"] {
  background: #0d4388;
  border-color: #0d4388;
  color: #fff;
}

.yearInputs {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  align-items: end;
  margin-bottom: 10px;
}

.yearInputs label {
  font-size: 9px;
  font-weight: 900;
  text-transform: uppercase;
  color: #56749a;
}

.yearInputs input {
  display: block;
  width: 96px;
  border: 1px solid #cfe0f4;
  border-radius: 9px;
  padding: 8px;
  font-weight: 900;
  color: #07356e;
}

.yearInputs span {
  border: 1px solid #d5e5f7;
  border-radius: 999px;
  padding: 9px 12px;
  background: #fff;
  font-weight: 900;
}

.timelineViewport {
  overflow-x: auto;
  border: 1px solid #d9e8f9;
  border-radius: 16px;
  background: linear-gradient(180deg, #f8fbff 0%, #fff 100%);
}

.timelineCanvas {
  position: relative;
  padding: 38px 12px 58px 150px;
}

.decadeBand {
  position: absolute;
  left: 150px;
  right: 12px;
  top: 0;
  height: 100%;
  pointer-events: none;
}

.decadeBlock {
  position: absolute;
  top: 0;
  bottom: 0;
  border-left: 1px solid rgba(8, 63, 129, .17);
}

.decadeBlock[data-even="true"] {
  background: rgba(12, 77, 145, .04);
}

.decadeBlock span {
  position: absolute;
  top: 8px;
  left: 4px;
  font-size: 11px;
  font-weight: 900;
  color: #245b96;
}

.timelineLane {
  display: grid;
  grid-template-columns: 130px 1fr;
  align-items: center;
  gap: 8px;
  min-height: 48px;
  position: relative;
  z-index: 2;
}

.laneLabel {
  border-radius: 10px;
  padding: 10px;
  background: #eef5fd;
  font-weight: 900;
  color: #07356e;
  font-size: 12px;
}

.laneTrack {
  position: relative;
  height: 38px;
  border-bottom: 1px solid rgba(12, 77, 145, .16);
}

.timelineItem {
  position: absolute;
  top: 4px;
  height: 30px;
  border: 1px solid rgba(255,255,255,.65);
  border-radius: 9px;
  color: #fff;
  box-shadow: 0 4px 12px rgba(0,0,0,.12);
  cursor: pointer;
  overflow: hidden;
  padding: 3px 8px;
  text-align: center;
}

.timelineItem strong,
.timelineItem span {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.timelineItem strong {
  font-size: 11px;
  line-height: 12px;
}

.timelineItem span {
  font-size: 10px;
  line-height: 10px;
}

.timelineItem[data-tone="blue"] { background: linear-gradient(180deg, #4ba4d4, #1e76aa); }
.timelineItem[data-tone="gold"] { background: linear-gradient(180deg, #d5b554, #9e7425); }
.timelineItem[data-tone="green"] { background: linear-gradient(180deg, #5bbf85, #22764c); }
.timelineItem[data-tone="red"] { background: linear-gradient(180deg, #e56b5e, #a92820); }
.timelineItem[data-tone="purple"] { background: linear-gradient(180deg, #a472c8, #6e42a0); }
.timelineItem[data-tone="steel"] { background: linear-gradient(180deg, #7b9bb5, #48657e); }

.timelineItem[data-active="true"] {
  outline: 3px solid rgba(10, 67, 135, .24);
}

.axisLine {
  position: absolute;
  left: 150px;
  right: 12px;
  bottom: 20px;
  height: 2px;
  background: #0c4d91;
}

.axisLine span {
  position: absolute;
  top: 8px;
  transform: translateX(-50%);
  font-size: 12px;
  font-weight: 900;
  color: #0c4d91;
}

.timelineInfo {
  margin-top: 10px;
  border: 1px solid #d8e6f6;
  border-radius: 14px;
  background: #fff;
  padding: 12px;
}

.timelineInfo strong {
  display: block;
  font-family: Georgia, serif;
  color: #0a4285;
  font-size: 22px;
}

.timelineInfo span {
  display: inline-block;
  margin: 5px 0;
  border-radius: 999px;
  padding: 5px 9px;
  background: #eff6ff;
  font-weight: 900;
  font-size: 11px;
}

.timelineInfo p {
  margin: 4px 0 0;
  color: #506f94;
}

.dynamicArea {
  padding: 12px;
}

.segmentTabs {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
}

.dynamicGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.infoPanel {
  border: 1px solid #d8e6f6;
  border-radius: 14px;
  background: #fff;
  padding: 12px;
}

.infoPanel h2 {
  margin-bottom: 10px;
}

.fact {
  display: grid;
  grid-template-columns: 135px 1fr;
  gap: 10px;
  border-top: 1px solid #edf3fa;
  padding: 9px 0;
}

.fact span {
  color: #597696;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .06em;
  font-weight: 900;
}

.fact strong {
  color: #07356e;
  font-size: 13px;
}

.page[data-timeline-only="true"] .timelineShell {
  position: fixed;
  inset: 10px;
  z-index: 50;
  margin: 0;
  overflow: auto;
}

.page[data-timeline-only="true"] .hero,
.page[data-timeline-only="true"] .filterColumn,
.page[data-timeline-only="true"] .dynamicArea {
  display: none;
}

.page[data-timeline-only="true"] .layout {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

@media (max-width: 1100px) {
  .layout,
  .dynamicGrid {
    grid-template-columns: 1fr;
  }

  .filterColumn {
  width: min(520px, 100%);
  align-self: flex-end;
  padding: 10px;
  position: static;
  border: 1px solid #d5e5f7;
  border-radius: 16px;
  background: rgba(255,255,255,.96);
  box-shadow: 0 10px 30px rgba(7, 53, 110, .08);
}

  .hero,
  .timelineHeader {
    flex-direction: column;
    align-items: stretch;
  }
}
@media (max-width: 800px) {
  .filterColumn {
    width: 100%;
    align-self: stretch;
  }

  .yearInputs {
    justify-content: flex-start;
    flex-wrap: wrap;
  }
}

