  border-color: var(--ct-row3-border) !important;
}

.filterColumn > .selectBox:nth-of-type(6) span,
.filterColumn > .selectBox:nth-of-type(6) select {
  color: var(--ct-row3-text) !important;
}

.filterColumn > .selectBox:nth-of-type(7) {
  background: var(--ct-row4-bg) !important;
  border-color: var(--ct-row4-border) !important;
}

.filterColumn > .selectBox:nth-of-type(7) span,
.filterColumn > .selectBox:nth-of-type(7) select {
  color: var(--ct-row4-text) !important;
}

/* ---------- topplinje ogsÃƒÂ¥ pÃƒÂ¥ select-bokser ---------- */

.selectBox {
  position: relative !important;
  overflow: hidden !important;
}

.selectBox::before {
  content: "" !important;
  position: absolute !important;
  left: 10px !important;
  right: 10px !important;
  top: 0 !important;
  height: 1px !important;
  background: var(--ct-border-soft) !important;
  pointer-events: none !important;
}

.filterColumn > .selectBox:nth-of-type(4)::before {
