  }
}

/* MÃƒÂ¸rk modus dersom global skin bruker data-attributt */
:global(html[data-skin*="dark"]) .page,
:global(body[data-skin*="dark"]) .page,
:global([data-theme="dark"]) .page {
  --ct-page-bg: var(--collectium-page-bg, #07111f);
  --ct-surface: var(--collectium-surface, rgba(13, 25, 43, .92));
  --ct-surface-soft: var(--collectium-surface-soft, rgba(17, 32, 54, .88));
  --ct-field-bg: var(--collectium-field-bg, rgba(10, 21, 37, .95));
  --ct-border: var(--collectium-border, rgba(93, 132, 177, .58));
  --ct-border-soft: var(--collectium-border-soft, rgba(78, 111, 151, .45));
  --ct-text: var(--collectium-text, #e7f0ff);
  --ct-text-soft: var(--collectium-text-soft, #a9bad1);
  --ct-heading: var(--collectium-heading, #d8e8ff);
  --ct-shadow: var(--collectium-shadow, 0 16px 34px rgba(0, 0, 0, .34));

  --ct-row1-bg: rgba(82, 157, 232, .18);
  --ct-row1-border: rgba(118, 183, 248, .72);
  --ct-row1-text: #d8eaff;

  --ct-row2-bg: rgba(210, 169, 67, .20);
  --ct-row2-border: rgba(230, 190, 85, .72);
  --ct-row2-text: #ffe7a8;

  --ct-row3-bg: rgba(87, 180, 126, .18);
  --ct-row3-border: rgba(112, 205, 152, .70);
  --ct-row3-text: #c9f5db;

  --ct-row4-bg: rgba(169, 125, 231, .20);
  --ct-row4-border: rgba(191, 151, 244, .72);
  --ct-row4-text: #ead9ff;
}

/* ---------- generelle bokser: ikke statisk hvit ---------- */

.hero,
.filterColumn,
.timelineShell,
.infoPanel,
.statusBox,
.timelineInfo,
.selectBox,
.selectedStack,
.fact {
  background: var(--ct-surface) !important;
  border: 1px solid var(--ct-border) !important;
  color: var(--ct-text) !important;
  box-shadow: var(--ct-shadow) !important;
}

/* Mykere felt inni kort */
.selectBox select,
.yearInputs > label,
.yearInputs input,
.timelineViewport,
.bioText {
  background: var(--ct-field-bg) !important;
  border: 1px solid var(--ct-border-soft) !important;
  color: var(--ct-text) !important;
}

/* Tekstfarger */
.hero h1,
.filterColumnHeader h2,
.timelineHeader h2,
.dynamicArea h2,
.infoPanel h2,
.timelineInfo strong {
  color: var(--ct-heading) !important;
}

.hero p,
.selectBox small,
.timelineInfo p,
.bioText,
.fact span,
.eyebrow {
  color: var(--ct-text-soft) !important;
}

.fact strong,
.selectBox select,
.yearInputs input {
  color: var(--ct-text) !important;
}

/* ---------- kantregel: 1px pÃƒÂ¥ alle bokser, aksent pÃƒÂ¥ toppen ---------- */

/* Fjern tidligere venstrekant pÃƒÂ¥ dynamiske felt */
.dynamicGrid .infoPanel:nth-child(2),
.infoPanel {
  border-left-width: 1px !important;
  border-left-color: var(--ct-border) !important;
}

/* Topplinje, ikke sidelinje */
.infoPanel::before,
.filterColumn::before,
.timelineShell::before,
.hero::before {
  content: "" !important;
  position: absolute !important;
  left: 14px !important;
  right: 14px !important;
  top: 0 !important;
  height: 1px !important;
  background: var(--ct-border) !important;
  pointer-events: none !important;
}

/* SÃƒÂ¸rg for posisjonering for topplinje */
.infoPanel,
.filterColumn,
.timelineShell,
.hero {
  position: relative !important;
  overflow: hidden !important;
}

/* Dynamiske kort fÃƒÂ¥r egen toppaksent etter innholdstype */
.dynamicGrid .infoPanel:nth-child(1)::before {
  background: var(--ct-row1-border) !important;
}

.dynamicGrid .infoPanel:nth-child(2)::before {
  background: var(--ct-row4-border) !important;
}

/* Ingen felles bakgrunn rundt dynamiske felt */
.dynamicArea,
.dynamicGrid {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

/* Selvstendige dynamiske kort */
.infoPanel {
  border-radius: 16px !important;
  padding: 12px !important;
  box-shadow: 0 16px 30px rgba(7, 53, 110, .12) !important;
}

:global(html[data-skin*="dark"]) .infoPanel,
:global(body[data-skin*="dark"]) .infoPanel,
:global([data-theme="dark"]) .infoPanel {
  box-shadow: 0 16px 34px rgba(0, 0, 0, .36) !important;
}

@media (prefers-color-scheme: dark) {
  .infoPanel {
    box-shadow: 0 16px 34px rgba(0, 0, 0, .36) !important;
  }
}

/* Biofelt fÃƒÂ¥r svak tone, ikke hard hvit */
.bioText {
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--ct-row1-border) 12%, transparent), transparent),
    var(--ct-surface-soft) !important;
  color: var(--ct-text) !important;
}

/* Faktarader skal ikke vÃƒÂ¦re hvite */
.fact {
  background: var(--ct-surface-soft) !important;
  border: 1px solid var(--ct-border-soft) !important;
  box-shadow: 0 5px 12px rgba(7, 53, 110, .045) !important;
}

/* ---------- Rad 1-4 filterfarger med lys/mÃƒÂ¸rk tokens ---------- */

.filterColumn > .selectBox:nth-of-type(4) {
  background: var(--ct-row1-bg) !important;
  border-color: var(--ct-row1-border) !important;
}

.filterColumn > .selectBox:nth-of-type(4)::before {
  background: var(--ct-row1-border) !important;
}

.filterColumn > .selectBox:nth-of-type(4) span,
.filterColumn > .selectBox:nth-of-type(4) select {
  color: var(--ct-row1-text) !important;
}

.filterColumn > .selectBox:nth-of-type(5) {
  background: var(--ct-row2-bg) !important;
  border-color: var(--ct-row2-border) !important;
}

.filterColumn > .selectBox:nth-of-type(5) span,
.filterColumn > .selectBox:nth-of-type(5) select {
  color: var(--ct-row2-text) !important;
}

.filterColumn > .selectBox:nth-of-type(6) {
