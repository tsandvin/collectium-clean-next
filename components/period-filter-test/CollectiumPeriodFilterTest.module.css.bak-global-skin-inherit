}

/* ---------- tidslinje: ikke statisk hvit/blÃƒÂ¥ ---------- */

.timelineViewport {
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--ct-surface-soft) 84%, transparent), transparent),
    var(--ct-surface) !important;
}

.decadeBlock[data-even="true"] {
  background: color-mix(in srgb, var(--ct-border) 12%, transparent) !important;
}

