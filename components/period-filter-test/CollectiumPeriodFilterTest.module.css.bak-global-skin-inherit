.layout {
  display: flex !important;
  flex-direction: column !important;
  gap: 10px !important;
}

.mainColumn {
  width: 100% !important;
  min-width: 0 !important;
}

.filterColumn {
  width: 100% !important;
  max-width: none !important;
  align-self: stretch !important;
  position: static !important;
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 8px !important;
  padding: 10px !important;
  border: 1px solid #d5e5f7 !important;
  border-radius: 16px !important;
  background: rgba(255, 255, 255, .96) !important;
  box-shadow: 0 10px 30px rgba(7, 53, 110, .08) !important;
}

.filterColumnHeader {
  grid-column: 1 / -1 !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: end !important;
  border-bottom: 1px solid #e3eef9 !important;
  padding-bottom: 6px !important;
  margin-bottom: 0 !important;
}

.filterColumnHeader h2 {
  margin: 0 !important;
  font-size: clamp(20px, 2.2vw, 30px) !important;
  line-height: 1 !important;
}

.filterDivider {
  grid-column: 1 / -1 !important;
  margin: 2px 0 0 !important;
  border-top: 1px solid #d8e6f6 !important;
  padding-top: 8px !important;
  font-size: 10px !important;
  text-transform: uppercase !important;
  letter-spacing: .08em !important;
  font-weight: 900 !important;
  color: #0b4387 !important;
}

.selectBox {
  min-width: 0 !important;
  display: block !important;
  border: 1px solid #d8e6f6 !important;
  border-radius: 12px !important;
  background: #f9fcff !important;
  padding: 8px !important;
  margin-top: 0 !important;
}

.selectBox span {
  display: block !important;
  margin-bottom: 4px !important;
