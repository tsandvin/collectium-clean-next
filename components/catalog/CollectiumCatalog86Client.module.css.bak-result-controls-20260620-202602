/**
 * COLLECTIUM FILE HEADER
 *
 * Overskrift:
 * Katalog UI/UX 8.6 modul-CSS
 *
 * Definering / formål:
 * Lokal komponent-CSS for kataloginnhold. Definerer ikke global body,
 * topbar, sidemeny, shell, skinmotor eller sidebakgrunn.
 *
 * Bruksområde:
 * Brukes av CollectiumCatalog86Client.
 *
 * Berørte sider / routes:
 * - /katalog
 *
 * Berørte DB-brytere / feature_keys:
 * - catalog.view
 * - catalog.search
 * - catalog.filters
 *
 * Berørte API-ruter:
 * - GET /api/catalog/search
 * - GET /api/catalog/filters
 *
 * Dataretning:
 * React -> UI
 *
 * Versjon:
 * CT-FILE-CATALOG86-0004 / CHANGE-2026-06-20-0001
 */

.catalogPage {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: clamp(14px, 2vw, 22px);
  color: var(--ct-text, #142033);
}

.pageHeader,
.controlBand,
.filterDeck,
.resultToolbar,
.emptyState,
.objectCard {
  position: relative;
  border: 1px solid color-mix(in srgb, var(--ct-border, #b9c9dd) 72%, transparent);
  background: color-mix(in srgb, var(--ct-panel, #ffffff) 94%, transparent);
  box-shadow: var(--ct-shadow-soft, 0 18px 45px rgba(18, 39, 74, 0.08));
  border-radius: var(--ct-radius-lg, 18px);
}

.pageHeader::after,
.controlBand::after,
.filterDeck::after,
.resultToolbar::after,
.emptyState::after,
.objectCard::after {
  content: "──────── Collectium";
  position: absolute;
  right: 16px;
  bottom: 7px;
  font-size: 8px;
  letter-spacing: 0.12em;
  color: color-mix(in srgb, var(--ct-accent, #2c5e94) 62%, transparent);
  pointer-events: none;
}

.pageHeader {
  padding: clamp(18px, 2.6vw, 30px);
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18px;
  align-items: end;
}

.eyebrow {
  margin: 0 0 6px;
  font-size: 0.75rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ct-muted, #60728a);
}

.pageHeader h1 {
  margin: 0;
  font-size: clamp(1.6rem, 3vw, 3rem);
  line-height: 1;
  letter-spacing: -0.04em;
}

.lead {
  max-width: 900px;
  margin: 10px 0 0;
  color: var(--ct-muted, #60728a);
  line-height: 1.5;
}

.headerStatus {
  min-width: 190px;
  display: grid;
  gap: 5px;
  justify-items: end;
  font-size: 0.85rem;
  color: var(--ct-muted, #60728a);
}

.headerStatus strong {
  color: var(--ct-text, #142033);
}

.controlBand {
  padding: 12px;
  display: flex;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
}

.segmentSwitch,
.viewSwitch,
.chipRow,
.filterActions,
.checkGrid {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}

.softButton,
.activeButton,
.chip,
.activeChip,
.actionArea button,
.openButton {
  border: 1px solid color-mix(in srgb, var(--ct-border, #b9c9dd) 72%, transparent);
  border-radius: var(--ct-radius-sm, 10px);
  padding: 0.55rem 0.8rem;
  font: inherit;
  text-decoration: none;
  cursor: pointer;
  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
}

.softButton,
.chip,
.actionArea button {
  background: color-mix(in srgb, var(--ct-panel, #ffffff) 88%, var(--ct-accent, #2c5e94) 4%);
  color: var(--ct-text, #142033);
}

.activeButton,
.activeChip,
.openButton {
  background: var(--ct-accent, #1f5d92);
  color: var(--ct-accent-contrast, #ffffff);
  border-color: color-mix(in srgb, var(--ct-accent, #1f5d92) 85%, #000 10%);
}

.softButton:hover,
.activeButton:hover,
.chip:hover,
.activeChip:hover,
.actionArea button:hover,
.openButton:hover {
  transform: translateY(-1px);
}

.filterDeck {
  padding: clamp(12px, 1.8vw, 20px);
  display: grid;
  grid-template-columns: repeat(4, minmax(230px, 1fr));
  gap: 12px;
}

.filterGroup {
  margin: 0;
  min-width: 0;
  border: 1px solid color-mix(in srgb, var(--ct-border, #b9c9dd) 72%, transparent);
  border-radius: var(--ct-radius-md, 14px);
  padding: 14px;
  display: grid;
  gap: 10px;
  background: color-mix(in srgb, var(--ct-panel, #ffffff) 96%, var(--ct-accent, #2c5e94) 2%);
}

.filterGroup legend {
  padding: 0 8px;
  font-weight: 700;
  color: var(--ct-text, #142033);
}

.filterGroup label,
.periodRow {
  display: grid;
  gap: 5px;
}

.filterGroup label span,
.periodRow > span,
.valueBox span,
.trendBox span,
.channelBox span,
.metaGrid span,
.cardHeaderLine,
.relationArea strong {
  font-size: 0.72rem;
  line-height: 1.25;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ct-muted, #60728a);
}

.filterGroup input,
.filterGroup select {
  min-width: 0;
  width: 100%;
  border: 1px solid color-mix(in srgb, var(--ct-border, #b9c9dd) 72%, transparent);
  border-radius: var(--ct-radius-sm, 10px);
  background: var(--ct-input-bg, #ffffff);
  color: var(--ct-text, #142033);
  padding: 0.62rem 0.72rem;
  font: inherit;
}

.checkboxLabel {
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 8px !important;
}

.checkboxLabel input {
  width: auto;
}

.periodGroup {
  grid-column: span 1;
}

.advancedGroup {
  grid-column: span 1;
}

.periodRows,
.specGrid {
  display: grid;
  gap: 10px;
}

.specGrid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.resultToolbar {
  padding: 12px 16px 18px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 14px;
  align-items: center;
}

.resultToolbar strong {
  font-size: 1.2rem;
}

.queryPreview {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 0.78rem;
  color: var(--ct-muted, #60728a);
  justify-self: end;
  max-width: 100%;
}

.emptyState {
  padding: 30px;
  display: grid;
  gap: 6px;
  color: var(--ct-muted, #60728a);
}

.results {
  display: grid;
  gap: 14px;
}

.results[data-view="standing"] {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.results[data-view="museum"] {
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
}

.objectCard {
  padding: 14px 14px 22px;
  display: grid;
  grid-template-columns: minmax(120px, 170px) minmax(0, 1.2fr) minmax(180px, 0.8fr) minmax(150px, 0.55fr) auto;
  gap: 14px;
  align-items: stretch;
}

.results[data-view="standing"] .objectCard,
.results[data-view="museum"] .objectCard {
  grid-template-columns: 1fr;
}

.results[data-view="list"] .objectCard {
  grid-template-columns: 76px minmax(0, 1.5fr) minmax(120px, 0.7fr) minmax(120px, 0.45fr) auto;
  gap: 10px;
  padding-top: 10px;
}

.imageArea {
  min-height: 110px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: var(--ct-radius-md, 14px);
  border: 1px solid color-mix(in srgb, var(--ct-border, #b9c9dd) 72%, transparent);
  background: color-mix(in srgb, var(--ct-accent, #2c5e94) 5%, var(--ct-panel, #ffffff));
  color: var(--ct-muted, #60728a);
  text-decoration: none;
  text-align: center;
  font-size: 0.8rem;
}

.results[data-view="list"] .imageArea {
  min-height: 66px;
}

.imageArea img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.identityArea,
.relationArea,
.marketArea,
.actionArea {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 10px;
}

.cardHeaderLine {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.cardHeaderLine p {
  margin: 0;
}

.identityArea h2 {
  margin: 0;
  font-size: clamp(1rem, 1.5vw, 1.35rem);
  line-height: 1.12;
  letter-spacing: -0.02em;
}

.identityArea h2 a {
  color: inherit;
  text-decoration: none;
}

.identityArea h2 a:hover {
  text-decoration: underline;
}

.metaGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.results[data-view="list"] .metaGrid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.results[data-view="standing"] .metaGrid,
.results[data-view="museum"] .metaGrid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.metaGrid div,
.valueBox,
.trendBox,
.channelBox {
  border: 1px solid color-mix(in srgb, var(--ct-border, #b9c9dd) 70%, transparent);
  border-radius: var(--ct-radius-sm, 10px);
  padding: 8px;
  min-width: 0;
  background: color-mix(in srgb, var(--ct-panel, #ffffff) 94%, var(--ct-accent, #2c5e94) 3%);
}

.metaGrid strong,
.valueBox strong,
.trendBox strong {
  display: block;
  margin-top: 4px;
  font-size: 0.9rem;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.relationChips {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.relationChips a {
  border: 1px solid color-mix(in srgb, var(--ct-accent, #2c5e94) 35%, var(--ct-border, #b9c9dd));
  border-radius: 999px;
  padding: 0.35rem 0.55rem;
  color: var(--ct-text, #142033);
  background: color-mix(in srgb, var(--ct-accent, #2c5e94) 7%, var(--ct-panel, #ffffff));
  text-decoration: none;
  font-size: 0.78rem;
}

.marketArea {
  align-content: stretch;
}

.channelBox {
  display: grid;
  gap: 5px;
}

.actionArea {
  min-width: 120px;
  align-content: start;
}

.actionArea button,
.openButton {
  width: 100%;
  text-align: center;
}

@media (max-width: 1180px) {
  .filterDeck {
    grid-template-columns: repeat(2, minmax(230px, 1fr));
  }

  .objectCard,
  .results[data-view="list"] .objectCard {
    grid-template-columns: minmax(100px, 140px) minmax(0, 1fr) minmax(150px, 0.7fr);
  }

  .relationArea,
  .actionArea {
    grid-column: 2 / -1;
  }
}

@media (max-width: 760px) {
  .pageHeader,
  .resultToolbar {
    grid-template-columns: 1fr;
  }

  .headerStatus,
  .queryPreview {
    justify-self: start;
  }

  .filterDeck {
    grid-template-columns: 1fr;
  }

  .specGrid,
  .metaGrid,
  .results[data-view="list"] .metaGrid,
  .results[data-view="standing"] .metaGrid,
  .results[data-view="museum"] .metaGrid {
    grid-template-columns: 1fr;
  }

  .objectCard,
  .results[data-view="list"] .objectCard,
  .results[data-view="museum"] .objectCard,
  .results[data-view="standing"] .objectCard {
    grid-template-columns: 1fr;
  }

  .relationArea,
  .actionArea {
    grid-column: auto;
  }

  .imageArea {
    min-height: 160px;
  }
}
